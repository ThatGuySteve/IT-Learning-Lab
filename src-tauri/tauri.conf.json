{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IT Learning Lab",
  "version": "0.1.0",
  "identifier": "org.itlearninglab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "IT Learning Lab", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["../licenses/*"],
    "windows": { "webviewInstallMode": { "type": "offlineInstaller" } }
  }
}
